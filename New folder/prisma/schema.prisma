generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum TransactionType {
  FUND
  WITHDRAW
  VEND
  REFUND
}
enum LedgerType{
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum MeterType {
  PREPAID
  POSTPAID
}


enum VendorStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}
enum UtilityStatus {
  PENDING
  SUCCESS
  FAILED
}

enum Role {
  USER
  ADMIN
}
enum OtpPurpose {
  REGISTER
  LOGIN
  PASSWORD_RESET
  FUND_WALLET
}
model Device {
  id           String   @id @default(uuid())
  userId       String
  deviceId     String
  name         String?
  ipAddress    String?
  userAgent    String?
  lastLoginAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
}
model VendorTransaction {
  id              String   @id @default(uuid())
  userId          String
  reference       String   @unique
  provider        String
  serviceType     String
  token           String?
  meterID         String?
  units           String?
  amount          Decimal  @default(0)
  status          VendorStatus
  requestPayload  Json
  responsePayload Json?
  externalRef     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OTP {
  id          String     @id @default(uuid())
  userId      String?
  phone       String?
  email       String?
  codeHash    String
  purpose     OtpPurpose
  expiresAt   DateTime
  attempts    Int        @default(0)
  verified    Boolean    @default(false)
  createdAt   DateTime   @default(now())

  user        User?      @relation(fields: [userId], references: [id])
}

model User {
  id       String @id @default(uuid())
  email    String? @unique
  phone    String? @unique
  password String
  role     Role   @default(USER)

  firstName String?
  lastName  String?
  failedAttempts Int @default(0)
  lockedUntill DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens        RefreshToken[]
  wallet               Wallet?
  transactions         Transaction[]
  electricityPurchases ElectricityPurchase[]
  conversations        AIConversation[]
  otps         OTP[] 
  devices Device[]
}
model LedgerEntry {
  id              String   @id @default(uuid())
  walletId        String
  transactionId   String?
  type            LedgerType
  amount          Decimal  @default(0)
  balanceBefore   Decimal  @default(0)
  balanceAfter    Decimal  @default(0)
  description     String?
  metadata        Json?
  wallet          Wallet   @relation(fields: [walletId], references: [id])

  createdAt       DateTime @default(now())
}
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id       String  @id @default(uuid())
  userId   String  @unique
  balance  Decimal @default(0)
  currency String  @default("NGN")
  locked   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries   LedgerEntry[]

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id       String @id @default(uuid())
  userId   String
  walletId String

  type        TransactionType
  amount      Decimal
  reference   String            @unique
  status      TransactionStatus @default(PENDING)
  description String?

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  electricityPurchase ElectricityPurchase?
}

model ElectricityPurchase {
  id            String @id @default(uuid())
  userId        String
  transactionId String @unique

  disco       String
  meterNumber String
  meterType   MeterType

  units  Decimal?
  token  String?
  status UtilityStatus @default(PENDING)

  createdAt DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  role      String // "user" | "assistant"
  message   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
