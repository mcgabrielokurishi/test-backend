model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String   @unique
  password  String

  firstName String?
  lastName  String?
  disco     String?     // AEDC, IKEDC, etc.
  meterType MeterType?
  meterNo   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MeterType {
  PREPAID
  POSTPAID
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
